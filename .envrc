use flake
dotenv

# Nix GitHub API auth: reuse the gh token (public_repo is enough, no extra secret
# to manage) to avoid anonymous 60 req/h rate limits. No secret lives in this file.
if command -v gh >/dev/null && [ -n "$(gh auth token 2>/dev/null)" ]; then
  export NIX_CONFIG="access-tokens = github.com=$(gh auth token)"
fi

# Inject secrets for OpenTofu (e.g. CLOUDFLARE_API_TOKEN) when present
if command -v sops >/dev/null && test -f secrets/cloudflare.env; then
  export CLOUDFLARE_API_TOKEN="$(sops exec-env --same-process secrets/cloudflare.env 'printenv CLOUDFLARE_API_TOKEN')"
fi

if command -v sops >/dev/null && test -f secrets/tailscale.env; then
  export TAILSCALE_OAUTH_CLIENT_ID="$(sops exec-env --same-process secrets/tailscale.env 'printenv TAILSCALE_OAUTH_CLIENT_ID')"
  export TAILSCALE_OAUTH_CLIENT_SECRET="$(sops exec-env --same-process secrets/tailscale.env 'printenv TAILSCALE_OAUTH_CLIENT_SECRET')"
fi
